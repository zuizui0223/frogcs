{"key":"97ce9818-7028-42a0-9743-ccb5897dec1f","installationKey":"3056a1fb-d172-4927-8f52-92246f9c768b","publishingOrganizationKey":"36488347-eceb-40ed-b687-406f3601d8cb","doi":"10.15468/tdocff","external":false,"numConstituents":0,"type":"OCCURRENCE","title":"Denver Botanic Gardens Collection of Arthropods","description":"<p>The Denver Botanic Gardens Collection of Arthropods (DBGA) is small reference and research collection focused on arthropods from urban and suburban habitats. Specimen and observation data is primarily collected from the Colorado Front Range. The collection also contains specimens from other areas in the Southern Rocky Mountain Region, particularly sites with ongoing research projects organized by the Denver Botanic Gardens. Identifications are often only to family level.</p>","language":"eng","citation":{"text":"Kathryn Kalmbach Herbarium (Denver Botanic Gardens) (2026). Denver Botanic Gardens Collection of Arthropods. Occurrence dataset https://doi.org/10.15468/tdocff accessed via GBIF.org on 2026-10-26.","citationProvidedBySource":false},"contactsCitation":[],"lockedForAutoUpdate":false,"createdBy":"symbiotascan","modifiedBy":"crawler.gbif.org","created":"2019-04-23T12:49:05.540+00:00","modified":"2026-10-21T15:21:30.927+00:00","contacts":[{"key":7653883,"type":"ORIGINATOR","primary":true,"userId":[],"position":[],"email":[],"phone":[],"homepage":["https://ecdysis.org/index.php"],"organization":"Ecdysis","address":[],"createdBy":"crawler.gbif.org","modifiedBy":"crawler.gbif.org","created":"2026-10-21T15:21:30.900+00:00","modified":"2026-10-21T15:21:30.900+00:00"},{"key":7653884,"type":"METADATA_AUTHOR","primary":true,"userId":[],"position":[],"email":[],"phone":[],"homepage":["https://ecdysis.org/index.php"],"organization":"Ecdysis","address":[],"createdBy":"crawler.gbif.org","modifiedBy":"crawler.gbif.org","created":"2026-10-21T15:21:30.903+00:00","modified":"2026-10-21T15:21:30.903+00:00"},{"key":7653885,"type":"ADMINISTRATIVE_POINT_OF_CONTA