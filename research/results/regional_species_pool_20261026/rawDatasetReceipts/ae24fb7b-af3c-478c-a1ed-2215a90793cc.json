{"key":"ae24fb7b-af3c-478c-a1ed-2215a90793cc","installationKey":"3056a1fb-d172-4927-8f52-92246f9c768b","publishingOrganizationKey":"9630292c-c8ef-4efa-adda-399638be3b19","doi":"10.15468/gqf6no","external":false,"numConstituents":0,"type":"OCCURRENCE","title":"Brigham Young University Arthropod Collection","description":"<p>The BYU Arthropod Collection is housed in the Bean Life Science Museum at Brigham Young University. It totals approximately 2,000,000 specimens, mostly insects. Although worldwide in coverage, an emphasis is on western North America. The collection&#39;s strengths include Coleoptera, Plecoptera, and Siphonaptera. The insect tissue holdings are outstanding. The principal aim is systematic study, but the collection is available to a wide variety of researchers.</p>","language":"eng","citation":{"text":"Brigham Young University, Arthropod Collection (2026). Brigham Young University Arthropod Collection. Occurrence dataset https://doi.org/10.15468/gqf6no accessed via GBIF.org on 2026-10-26.","citationProvidedBySource":false},"contactsCitation":[],"lockedForAutoUpdate":false,"createdBy":"symbiotascan","modifiedBy":"crawler.gbif.org","created":"2018-11-06T15:47:20.969+00:00","modified":"2026-10-02T13:16:12.683+00:00","contacts":[{"key":7632908,"type":"ORIGINATOR","primary":true,"userId":[],"position":[],"email":[],"phone":[],"homepage":["https://ecdysis.org/index.php"],"organization":"Ecdysis","address":[],"createdBy":"crawler.gbif.org","modifiedBy":"crawler.gbif.org","created":"2026-10-02T13:16:12.652+00:00","modified":"2026-10-02T13:16:12.652+00:00"},{"key":7632909,"type":"METADATA_AUTHOR","primary":true,"userId":[],"position":[],"email":[],"phone":[],"homepage":["https://ecdysis.org/index.php"],"organization":"Ecdysis","address":[],"createdBy":"crawler.gbif.org","modifiedBy":"crawler.gbif.org","created":"2026-10-02T13:16:12.654+00:00","modified":"2026-10-02T13:16:12.654+00:00"},{"key":7632910,"type":"ADMINISTRATIVE_POINT_OF_CONTACT","primary":true,"u