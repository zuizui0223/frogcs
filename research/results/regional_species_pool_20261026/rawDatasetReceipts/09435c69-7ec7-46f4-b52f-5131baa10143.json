{"key":"09435c69-7ec7-46f4-b52f-5131baa10143","installationKey":"394c0f8e-8b5e-4fbc-b942-568a4a267032","publishingOrganizationKey":"c1c50c16-d4fa-4fc7-85ae-86ede81f1f8f","doi":"10.15468/w9b6ap","version":"1.6","external":false,"numConstituents":0,"type":"OCCURRENCE","subtype":"SPECIMEN","shortName":"CUIC","title":"Cornell University Insect Collection (CUIC)","description":"\n            The Cornell University Insect Collection serves as a permanent repository for scientifically valuable terrestrial arthropod specimens and associated data representing global insect diversity, species of economic importance, and vouchers from scientific studies. Starting with J.H. Comstock and H.H. Smith in the 1870’s, today’s CUIC is the result of efforts by a long line of Cornell entomologists. Our taxonomic breadth is based on the sequential additions to our holdings by professors, staff and students who have exhibited dedication to the development of their diverse research interests.The CUIC supports insect identification, systematics research, education, and public outreach for the global community.\n        ","language":"eng","homepage":"https://cuic.entomology.cornell.edu/about/","citation":{"text":"Dombroskie J, Whisenant J (2026). Cornell University Insect Collection (CUIC). Version 1.6. Cornell University Insect Collection (CUIC). Occurrence dataset https://doi.org/10.15468/w9b6ap accessed via GBIF.org on 2026-10-26.","citationProvidedBySource":false},"contactsCitation":[{"key":6950868,"abbreviatedName":"Dombroskie J","firstName":"Jason","lastName":"Dombroskie","roles":["ORIGINATOR"],"userId":[]},{"key":6950869,"abbreviatedName":"Whisenant J","firstName":"Jack","lastName":"Whisenant","roles":["ORIGINATOR"],"userId":[]}],"lockedForAutoUpdate":false,"createdBy":"c1c50c16-d4fa-4fc7-85ae-86ede81f1f8f","modifiedBy":"crawler.gbif.org","created":"2024-12-28T20:59:43.144+00:00","modified":"2026-03-19T12:44:18.142+00:00","contacts":[{"key":6950868,"type":"ORIGINATOR","primary":true,"